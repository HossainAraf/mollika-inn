<h1>Admin Sign In</h1>

<%= form_with url: session_path, method: :post, local: true do %>
  <div>
    <%= label_tag :email, "Email" %><br>
    <%= email_field_tag :email, params[:email], required: true, autocomplete: "username" %>
  </div>

  <div>
    <%= label_tag :password, "Password" %><br>
    <%= password_field_tag :password, nil, required: true, autocomplete: "current-password" %>
  </div>

  <div>
    <%= submit_tag "Sign In" %>
  </div>
<% end %>