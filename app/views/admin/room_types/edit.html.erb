<h1 class="text-2xl font-bold mb-6">Edit Room Type</h1>

<div class="bg-white shadow rounded-lg p-6">
  <%= form_with model: [:admin, @room_type], html: { multipart: true, class: "space-y-6" }, local: true do |f| %>
    
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :name, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :description, rows: 4, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :max_occupancy, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.number_field :max_occupancy, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :bed_type, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :bed_type, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :size_sqm, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.number_field :size_sqm, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :base_price_per_night, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.number_field :base_price_per_night, step: 0.01, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :photos, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.file_field :photos, multiple: true, class: "w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4
        file:rounded-lg file:border-0 file:text-sm file:font-semibold
        file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    </div>

    <div>
      <%= f.submit "Update Room Type",
          class: "px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>
