<h1 class="text-2xl font-bold mb-6">Room Types</h1>

<div class="mb-4">
  <%= link_to "New Room Type", new_admin_room_type_path,
      class: "inline-block px-4 py-2 bg-green-600 text-white font-semibold rounded-lg shadow hover:bg-green-700 transition" %>
</div>

<div class="bg-white shadow rounded-lg">
  <ul class="divide-y divide-gray-200">
    <% @room_types.each do |room_type| %>
      <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-4 px-4">
        <span class="text-gray-900 font-medium"><%= room_type.name %></span>
        <div class="mt-2 sm:mt-0 space-x-2">
          <%= link_to "View", admin_room_type_path(room_type),
              class: "inline-block px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
          <%= link_to "Edit", edit_admin_room_type_path(room_type),
              class: "inline-block px-3 py-1 text-sm bg-yellow-500 text-white rounded hover:bg-yellow-600 transition" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
