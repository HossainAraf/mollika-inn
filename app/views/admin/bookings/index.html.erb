<% content_for :page_title, "Bookings" %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Bookings</h1>
      <p class="mt-1 text-sm text-slate-500"><%= @bookings.total_count rescue @bookings.count %> bookings found</p>
    </div>

    <div class="flex flex-wrap gap-2">
      <% [["All", ""], ["Pending", "pending"], ["Confirmed", "confirmed"], ["Checked In", "checked_in"], ["Checked Out", "checked_out"], ["Cancelled", "cancelled"]].each do |label, val| %>
        <%= link_to label, admin_bookings_path(status: val.presence), class: "rounded-lg border px-3 py-1.5 text-xs font-semibold #{params[:status].to_s == val ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'}" %>
      <% end %>
    </div>
  </div>

  <%= form_with url: admin_bookings_path, method: :get, local: true, class: "grid gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-4" do |f| %>
    <div>
      <%= f.label :q, "Search", class: "block text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400" %>
      <%= f.text_field :q, value: params[:q], placeholder: "Guest, email, booking ref", class: "mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-slate-400 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :from, "Check-in from", class: "block text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400" %>
      <%= f.date_field :from, value: params[:from], class: "mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-slate-400 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :to, "Check-out to", class: "block text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400" %>
      <%= f.date_field :to, value: params[:to], class: "mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-slate-400 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :payment_status, "Payment status", class: "block text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400" %>
      <%= f.select :payment_status, options_for_select([["All", ""]] + Booking::PAYMENT_STATUSES.map { |status| [status.titleize, status] }, params[:payment_status]), {}, class: "mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-slate-400 focus:outline-none" %>
      <div class="mt-3 flex gap-2">
        <%= f.submit "Filter", class: "inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800" %>
        <%= link_to "Clear", admin_bookings_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>
    </div>
  <% end %>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @bookings.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
              <th class="px-5 py-3">Ref</th>
              <th class="px-4 py-3">Guest</th>
              <th class="px-4 py-3">Room</th>
              <th class="px-4 py-3">Check-in</th>
              <th class="px-4 py-3">Check-out</th>
              <th class="px-4 py-3">Nights</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Payment</th>
              <th class="px-4 py-3">Total</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            <% @bookings.each do |booking| %>
              <tr class="border-t border-slate-100 hover:bg-slate-50">
                <td class="px-5 py-3">
                  <%= link_to "#MIB-#{booking.id.to_s.rjust(4,'0')}", admin_booking_path(booking), class: "font-mono text-xs font-semibold text-slate-700 hover:text-slate-900" %>
                </td>
                <td class="px-4 py-3">
                  <div>
                    <p class="text-sm font-medium text-slate-800"><%= booking.guest&.full_name || "—" %></p>
                    <p class="text-xs text-slate-400"><%= booking.guest&.email&.truncate(24) %></p>
                  </div>
                </td>
                <td class="px-4 py-3 text-xs text-slate-600"><%= booking.booking_rooms.first&.room_type&.name || "—" %></td>
                <td class="px-4 py-3 text-xs text-slate-600"><%= booking.check_in_date.strftime("%d %b %Y") %></td>
                <td class="px-4 py-3 text-xs text-slate-600"><%= booking.check_out_date.strftime("%d %b %Y") %></td>
                <td class="px-4 py-3 text-xs text-slate-600"><%= booking.nights %></td>
                <td class="px-4 py-3">
                  <% badge_colors = { "pending" => "bg-amber-100 text-amber-700", "confirmed" => "bg-sky-100 text-sky-700", "checked_in" => "bg-emerald-100 text-emerald-700", "checked_out" => "bg-slate-200 text-slate-700", "cancelled" => "bg-rose-100 text-rose-700" } %>
                  <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= badge_colors[booking.status] || 'bg-slate-100 text-slate-600' %>"><%= booking.status.titleize %></span>
                </td>
                <td class="px-4 py-3">
                  <% pay_colors = { "paid" => "bg-emerald-100 text-emerald-700", "partial" => "bg-orange-100 text-orange-700", "unpaid" => "bg-rose-100 text-rose-700", "refunded" => "bg-slate-200 text-slate-700" } %>
                  <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= pay_colors[booking.payment_status] || 'bg-slate-100 text-slate-600' %>"><%= booking.payment_status.titleize %></span>
                </td>
                <td class="px-4 py-3 text-sm font-semibold text-slate-800">৳<%= number_with_delimiter(booking.total_amount.to_i) %></td>
                <td class="px-4 py-3">
                  <%= link_to "View", admin_booking_path(booking), class: "text-xs font-semibold text-slate-700 hover:text-slate-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-20 text-center">
        <p class="text-3xl mb-2">📅</p>
        <p class="text-sm text-slate-400">No bookings found</p>
        <% if params[:status].present? %>
          <p class="mt-2 text-xs text-slate-500"><%= link_to "Clear filter", admin_bookings_path, class: "underline" %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
