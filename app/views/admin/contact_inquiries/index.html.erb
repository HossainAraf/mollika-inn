<h1 class="text-2xl font-bold mb-6">Contact Inquiries</h1>

<div class="bg-white shadow rounded-lg p-4">
  <ul class="divide-y divide-gray-200">
    <% @contact_inquiries.each do |inquiry| %>
      <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-4">
        <div class="flex flex-col">
          <span class="text-gray-900 font-medium"><%= inquiry.name %></span>
          <span class="text-sm text-gray-500">Status: <%= inquiry.status %></span>
        </div>
        <div class="mt-2 sm:mt-0">
          <%= link_to "View", admin_contact_inquiry_path(inquiry),
              class: "inline-block px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded hover:bg-blue-700 transition" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
