<h1 class="text-2xl font-bold mb-6">Inquiry #<%= @inquiry.id %></h1>

<div class="bg-white shadow rounded-lg p-6 space-y-4">
  <p class="text-gray-700"><span class="font-semibold">Name:</span> <%= @inquiry.name %></p>
  <p class="text-gray-700"><span class="font-semibold">Email:</span> <%= @inquiry.email %></p>
  <p class="text-gray-700"><span class="font-semibold">Subject:</span> <%= @inquiry.subject %></p>
  <p class="text-gray-700"><span class="font-semibold">Message:</span> <%= @inquiry.message %></p>
</div>

<div class="mt-6 bg-white shadow rounded-lg p-6">
  <%= form_with model: [:admin, @inquiry], method: :patch, local: true, html: { class: "space-y-6" } do |f| %>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.select :status, ContactInquiry::STATUSES,
            {}, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>
    <div>
      <%= f.submit "Update",
            class: "px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>
