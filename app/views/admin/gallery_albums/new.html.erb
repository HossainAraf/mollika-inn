<h1>New Album</h1>

<%= form_with model: [:admin, @gallery_album] do |f| %>
  <div><%= f.label :name %><br><%= f.text_field :name %></div>
  <div><%= f.label :description %><br><%= f.text_area :description %></div>
  <div><%= f.label :position %><br><%= f.number_field :position %></div>
  <div><%= f.label :visible %><br><%= f.check_box :visible %></div>
  <div><%= f.submit "Create Album" %></div>
<% end %>