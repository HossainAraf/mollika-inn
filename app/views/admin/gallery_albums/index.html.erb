<h1>Gallery Albums</h1>
<h2 class="font-serif text-red-600 text-4xl md:text-5xl font-bold">ONLY FOR PREMIUM SUBSCRIBERS</h2>

<p><%= link_to "New Album", new_admin_gallery_album_path %></p>

<ul>
  <% @gallery_albums.each do |album| %>
    <li><%= album.name %> - <%= link_to "View", admin_gallery_album_path(album) %> - <%= link_to "Update", edit_admin_gallery_album_path(album) %> - <%= link_to "Delete", admin_gallery_album_path(album), method: :delete, confirm: "Are you sure?" %></li>
    
  <% end %>
</ul>