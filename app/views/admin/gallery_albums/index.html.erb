<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Gallery Albums</h1>
      <h2 class="text-2xl text-red-700 font-semibold mb-4">* Only Premium Subscribers are allowed to use this option.</h2>
      <p class="text-sm text-gray-500 mt-1">Manage public gallery collections</p>
    </div>

    <%= link_to "New Album", new_admin_gallery_album_path, class: "btn-primary w-full sm:w-auto text-center" %>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <ul class="divide-y divide-gray-200">
      <% @gallery_albums.each do |album| %>
        <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0 flex-1">
            <p class="text-base font-semibold text-gray-900"><%= album.name %></p>
            <p class="text-sm text-gray-500 break-words"><%= album.description.presence || "No description yet." %></p>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
            <%= link_to "View", admin_gallery_album_path(album), class: "btn-secondary w-full sm:w-auto text-center" %>
            <%= link_to "Edit", edit_admin_gallery_album_path(album), class: "btn-secondary w-full sm:w-auto text-center" %>
            <%= button_to "Delete", admin_gallery_album_path(album), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn-secondary w-full sm:w-auto" %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>