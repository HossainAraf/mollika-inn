<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @gallery_album.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @gallery_album.description.presence || "No description provided." %></p>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row">
      <%= link_to "Edit", edit_admin_gallery_album_path(@gallery_album), class: "btn-primary w-full sm:w-auto text-center" %>
      <%= link_to "Back", admin_gallery_albums_path, class: "btn-secondary w-full sm:w-auto text-center" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Add image</h2>

    <%= form_with model: [:admin, @gallery_album, GalleryImage.new], html: { class: "space-y-4" }, local: true do |f| %>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="md:col-span-1">
          <%= f.label :caption, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :caption, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :position, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :position, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :image, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.file_field :image, class: "w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
        </div>
      </div>

      <%= f.submit "Add Image", class: "btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>

  <% if @gallery_album.gallery_images.any? %>
    <div class="mt-6 bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Album images</h2>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @gallery_album.gallery_images.each do |image| %>
          <div class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
            <% if image.image.attached? %>
              <%= image_tag image.image, class: "h-48 w-full object-cover" %>
            <% else %>
              <div class="flex h-48 items-center justify-center bg-gray-200 text-gray-500">No image</div>
            <% end %>

            <div class="flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between">
              <span class="text-sm text-gray-700 break-words"><%= image.caption.presence || "Untitled image" %></span>
              <%= button_to "Delete", admin_gallery_album_gallery_image_path(@gallery_album, image), method: :delete, form: { data: { turbo_confirm: "Delete this image?" } }, class: "btn-secondary w-full sm:w-auto" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="mt-6 rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-gray-500">
      No images have been added to this album yet.
    </div>
  <% end %>
</div>