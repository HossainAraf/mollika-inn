<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6 text-gray-900">Edit Review</h1>

  <div class="bg-white shadow rounded-lg p-6">
    <%= form_with model: [:admin, @review], html: { class: "space-y-6" }, local: true do |f| %>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <%= f.label :rating, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :rating, in: 1..5, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="flex items-center pt-8">
          <%= f.check_box :approved, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <%= f.label :approved, class: "ml-2 block text-sm font-medium text-gray-700" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :title, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :body, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :body, rows: 6, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <%= f.submit "Update Review", class: "btn-primary w-full sm:w-auto" %>
        <%= link_to "Cancel", admin_reviews_path, class: "btn-secondary w-full sm:w-auto text-center" %>
      </div>
    <% end %>
  </div>
</div>