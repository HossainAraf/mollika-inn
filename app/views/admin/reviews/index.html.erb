<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Reviews</h1>
    <p class="mt-1 text-sm text-gray-500">Guest feedback and approval queue</p>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-sm">
        <thead class="bg-slate-50">
          <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
            <th class="px-4 py-3">Rating</th>
            <th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Guest</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr class="border-t border-slate-100 hover:bg-slate-50 align-top">
              <td class="px-4 py-3 text-slate-700"><%= review.rating %>/5</td>
              <td class="px-4 py-3 text-slate-700"><%= review.title %></td>
              <td class="px-4 py-3 text-slate-700"><%= review.guest&.full_name || "—" %></td>
              <td class="px-4 py-3 text-slate-700"><%= review.approved? ? "Approved" : "Pending" %></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                  <%= link_to "View", admin_review_path(review), class: "btn-secondary w-full sm:w-auto text-center" %>
                  <%= link_to "Edit", edit_admin_review_path(review), class: "btn-secondary w-full sm:w-auto text-center" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>