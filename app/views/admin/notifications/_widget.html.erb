<details id="admin-notification-widget" class="relative">
  <summary class="flex list-none items-center gap-2 rounded-full border border-emerald-200/60 bg-white/60 px-3 py-1.5 text-gray-700 shadow-sm transition hover:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400/30 cursor-pointer">
    <span class="text-base">🔔</span>
    <span class="text-xs font-semibold uppercase tracking-wider text-gray-600">Alerts</span>

    <span id="admin-notification-count">
      <%= render "admin/notifications/count", unread_count: unread_count %>
    </span>
  </summary>

  <div class="absolute right-0 z-30 mt-3 w-[22rem] overflow-hidden rounded-2xl border border-white/10 bg-gray-900/95 shadow-2xl backdrop-blur-md">

    <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
      <div>
        <p class="text-sm font-semibold text-white">Admin Notifications</p>
        <p class="text-xs text-gray-400">
          <%= unread_count %> unread
        </p>
      </div>

      <button
        type="button"
        class="rounded-full border border-white/10 bg-white/5 p-1.5 text-lg leading-none text-gray-300 transition hover:bg-white/10 hover:text-white"
        data-close-notification-widget
        aria-label="Close notifications"
        onClick="this.closest('details').open = false;"
        >
        ×
      </button>
    </div>

    <div
      id="admin-notification-list"
      class="max-h-96 space-y-2 overflow-y-auto p-3">
      <%= render "admin/notifications/list", notifications: notifications %>
    </div>

    <div class="border-t border-white/10 px-4 py-3">
      <%= link_to "View all notifications",
        admin_notifications_path,
        class: "text-sm font-semibold text-emerald-300 hover:text-emerald-200" %>
    </div>

  </div>
</details>