<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6 text-gray-900">New Guest</h1>

  <div class="bg-white shadow rounded-lg p-6">
    <%= form_with model: [:admin, @guest], html: { class: "space-y-6" }, local: true do |f| %>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :first_name, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :last_name, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :phone, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :address, rows: 4, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :nationality, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :nationality, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :nid_or_passport, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :nid_or_passport, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <%= f.submit "Create Guest", class: "btn-primary w-full sm:w-auto" %>
        <%= link_to "Cancel", admin_guests_path, class: "btn-secondary w-full sm:w-auto text-center" %>
      </div>
    <% end %>
  </div>
</div>