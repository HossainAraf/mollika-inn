<% content_for :page_title, "Rooms" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Rooms</h1>
    <p class="text-sm text-gray-400 mt-0.5"><%= @rooms.count %> rooms total</p>
  </div>
  <%= link_to "+ Add Room", new_admin_room_path, class: "text-white text-sm font-semibold px-4 py-2 rounded-lg", style: "background:#c3e0d2" %>
</div>

<%# Summary Cards %>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
  <% statuses = { "available" => ["✅","Available","bg-green-50 border-green-100"], "occupied" => ["🔴","Occupied","bg-red-50 border-red-100"], "maintenance" => ["🔧","Maintenance","bg-yellow-50 border-yellow-100"], "reserved" => ["📌","Reserved","bg-blue-50 border-blue-100"] } %>
  <% statuses.each do |status, (icon, label, colors)| %>
    <div class="rounded-xl border p-4 <%= colors %>">
      <div class="flex items-center gap-2">
        <span class="text-lg"><%= icon %></span>
        <div>
          <p class="text-xl font-bold text-gray-900"><%= @rooms.select { |r| r.status == status }.count %></p>
          <p class="text-xs text-gray-500"><%= label %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-100">
        <tr>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-5 py-3">Room</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Type</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Floor</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Capacity</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Rate/Night</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Status</th>
          <th class="text-left text-xs text-gray-400 font-semibold uppercase tracking-wide px-4 py-3">Current Guest</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @rooms.order(:room_number).each do |room| %>
          <%
            active_booking = room.bookings.active.first rescue nil
            status_colors = {
              "available"   => "bg-green-100 text-green-700",
              "occupied"    => "bg-red-100 text-red-700",
              "maintenance" => "bg-yellow-100 text-yellow-700",
              "reserved"    => "bg-blue-100 text-blue-700"
            }
          %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-5 py-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold text-white" style="background:#1a3a2a;"><%= room.room_number %></div>
                <p class="font-semibold text-gray-800">Room <%= room.room_number %></p>
              </div>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= room.room_type.name %></td>
            <td class="px-4 py-3 text-xs text-gray-600">Floor <%= room.floor %></td>
            <td class="px-4 py-3 text-xs text-gray-600">Up to <%= room.room_type.max_occupancy %></td>
            <td class="px-4 py-3 text-xs font-semibold text-gray-800">৳<%= number_with_delimiter(room.room_type.base_price_per_night.to_i) %></td>
            <td class="px-4 py-3">
              <span class="badge <%= status_colors[room.status] || 'bg-gray-100 text-gray-500' %>"><%= room.status.titleize %></span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <% if active_booking %>
                <%= active_booking.display_guest_name %><br>
                <span class="text-gray-400">until <%= active_booking.check_out_date.strftime("%d %b") %></span>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 flex items-center gap-2">
              <%= link_to "View", admin_room_path(room), class: "text-xs font-semibold hover:underline", style: "color:#1a3a2a;" %>
              <%= link_to "Edit", edit_admin_room_path(room), class: "text-xs text-gray-400 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
