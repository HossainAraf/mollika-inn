<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6 text-gray-900">New Room</h1>

  <div class="bg-white shadow rounded-lg p-6">
    <%= form_with model: [:admin, @room], html: { class: "space-y-6" }, local: true do |f| %>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <%= f.label :room_type_id, "Room Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.collection_select :room_type_id, @room_types, :id, :name, {}, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :room_number, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :room_number, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :floor, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :floor, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :status, Room::STATUSES, {}, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :notes, rows: 4, class: "w-full border-gray-300 rounded-lg shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <%= f.submit "Create Room", class: "btn-primary w-full sm:w-auto" %>
        <%= link_to "Cancel", admin_rooms_path, class: "btn-secondary w-full sm:w-auto text-center" %>
      </div>
    <% end %>
  </div>
</div>