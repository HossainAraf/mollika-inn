<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4"><%= @menu_item.name %></h1>

  <div class="bg-white p-6 rounded-lg shadow-sm">
    <p><strong>Category:</strong> <%= @menu_item.category %></p>
    <p><strong>Price:</strong> ৳<%= @menu_item.price %></p>
    <p><strong>Available:</strong> <%= @menu_item.available ? "Yes" : "No" %></p>
    <% if @menu_item.description.present? %>
      <div class="mt-4"><%= simple_format(@menu_item.description) %></div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "Edit", edit_admin_menu_item_path(@menu_item), class: "btn-primary" %>
    <%= link_to "Back", admin_menu_items_path, class: "btn-secondary ml-2" %>
  </div>
</div>
<%# Header %>
<div class="py-8 bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @menu_item.name %></h1>
        <p class="text-gray-500 mt-1">Menu item details</p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_admin_menu_item_path(@menu_item), class: "px-4 py-2 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50" %>
        <%= link_to "Back to Menu Items", admin_menu_items_path, class: "px-4 py-2 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50" %>
      </div>
    </div>
  </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="space-y-4">
      <div class="flex justify-between py-3 border-b border-gray-200">
        <span class="text-gray-600 font-medium">Name</span>
        <span class="text-gray-900 font-semibold"><%= @menu_item.name %></span>
      </div>
      <div class="flex justify-between py-3 border-b border-gray-200">
        <span class="text-gray-600 font-medium">Category</span>
        <span class="text-gray-900 font-semibold"><%= @menu_item.category.titleize %></span>
      </div>
      <div class="flex justify-between py-3 border-b border-gray-200">
        <span class="text-gray-600 font-medium">Price</span>
        <span class="text-gray-900 font-semibold">৳<%= number_with_delimiter(@menu_item.price.to_i) %></span>
      </div>
      <div class="flex justify-between py-3 border-b border-gray-200">
        <span class="text-gray-600 font-medium">Available</span>
        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= @menu_item.available ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
          <%= @menu_item.available ? 'Yes' : 'No' %>
        </span>
      </div>
      <div class="flex justify-between py-3 border-b border-gray-200">
        <span class="text-gray-600 font-medium">Position</span>
        <span class="text-gray-900 font-semibold"><%= @menu_item.position || '-' %></span>
      </div>
      <div class="py-3">
        <span class="text-gray-600 font-medium block mb-2">Description</span>
        <p class="text-gray-900"><%= @menu_item.description %></p>
      </div>
    </div>
  </div>
</div>
