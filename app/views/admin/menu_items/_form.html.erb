<%= form_with model: [:admin, @menu_item], local: true do |f| %>
  <% if @menu_item.errors.any? %>
    <div class="mb-4 text-red-700">
      <p><strong>Please fix the following:</strong></p>
      <ul>
        <% @menu_item.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :category, class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :category, MenuItem::CATEGORIES, {}, class: "mt-1 block w-full rounded-md border-gray-300" %>
      </div>
      <div>
        <%= f.label :price, class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :price, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :position, class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :position, class: "mt-1 block w-full rounded-md border-gray-300" %>
      </div>
      <div>
        <%= f.label :available, class: "block text-sm font-medium text-gray-700" %>
        <%= f.check_box :available, class: "mt-2" %>
      </div>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300" %>
    </div>

    <div class="pt-4">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "Cancel", admin_menu_items_path, class: "btn-secondary ml-2" %>
    </div>
  </div>
<% end %>
