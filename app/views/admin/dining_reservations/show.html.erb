<% content_for :page_title, "Dining Reservation Details" %>

<div class="mx-auto max-w-4xl space-y-6">
  <div class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Reservation</p>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">Dining Reservation #<%= @dining_reservation.id %></h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Back to list", admin_dining_reservations_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-lg font-semibold text-slate-800">Guest information</h2>
      <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= status_badge_class(@dining_reservation.status) %>">
        <%= @dining_reservation.status.titleize %>
      </span>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Guest name</p>
        <p class="mt-2 text-base font-semibold text-slate-800"><%= @dining_reservation.name %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Guest count</p>
        <p class="mt-2 text-base font-semibold text-slate-800"><%= @dining_reservation.number_of_guests %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Email</p>
        <p class="mt-2 text-base font-medium text-slate-800"><%= @dining_reservation.email %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Phone</p>
        <p class="mt-2 text-base font-medium text-slate-800"><%= @dining_reservation.phone %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Date</p>
        <p class="mt-2 text-base font-medium text-slate-800"><%= @dining_reservation.reservation_date.strftime("%d %b %Y") %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Time</p>
        <p class="mt-2 text-base font-medium text-slate-800"><%= @dining_reservation.reservation_time.to_s.gsub(/(\d{2})(\d{2})/, '\1:\2') %></p>
      </div>
    </div>

    <% if @dining_reservation.special_requests.present? %>
      <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Special requests</p>
        <p class="mt-2 text-sm leading-6 text-slate-700"><%= @dining_reservation.special_requests %></p>
      </div>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-800">Actions</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <% if @dining_reservation.status == "pending" %>
        <%= link_to "Confirm reservation", confirm_admin_dining_reservation_path(@dining_reservation), data: { turbo_method: :patch, turbo_confirm: "Confirm this reservation?" }, class: "inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
      <% end %>
      <% if @dining_reservation.status == "confirmed" %>
        <%= link_to "Mark as completed", complete_admin_dining_reservation_path(@dining_reservation), data: { turbo_method: :patch, turbo_confirm: "Mark as completed?" }, class: "inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
      <% if @dining_reservation.status != "cancelled" %>
        <%= link_to "Cancel reservation", cancel_admin_dining_reservation_path(@dining_reservation), data: { turbo_method: :patch, turbo_confirm: "Cancel this reservation?" }, class: "inline-flex items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700" %>
      <% end %>
    </div>
  </div>
</div>
