<% content_for :page_title, "Dining Reservations" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Dining Reservations</h1>
      <p class="mt-1 text-sm text-slate-500"><%= @dining_reservations.count %> reservations found</p>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Pending</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @dining_reservations.count { |r| r.status == "pending" } %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Confirmed</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @dining_reservations.count { |r| r.status == "confirmed" } %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Completed</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @dining_reservations.count { |r| r.status == "completed" } %></p>
    </div>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @dining_reservations.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
              <th class="px-5 py-3">Guest</th>
              <th class="px-4 py-3">Date & Time</th>
              <th class="px-4 py-3">Guests</th>
              <th class="px-4 py-3">Contact</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @dining_reservations.each do |reservation| %>
              <tr class="border-t border-slate-100 hover:bg-slate-50 align-top">
                <td class="px-5 py-3">
                  <div class="font-medium text-slate-800"><%= reservation.name %></div>
                </td>
                <td class="px-4 py-3 text-slate-600">
                  <div class="font-medium"><%= reservation.reservation_date.strftime("%d %b %Y") %></div>
                  <div class="text-xs text-slate-400"><%= reservation.reservation_time.to_s.gsub(/(\d{2})(\d{2})/, '\1:\2') %></div>
                </td>
                <td class="px-4 py-3 text-slate-600"><%= reservation.number_of_guests %></td>
                <td class="px-4 py-3 text-slate-600">
                  <div class="font-medium"><%= reservation.email %></div>
                  <div class="text-xs text-slate-400"><%= reservation.phone %></div>
                </td>
                <td class="px-4 py-3">
                  <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= status_badge_class(reservation.status) %>">
                    <%= reservation.status.titleize %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", admin_dining_reservation_path(reservation), class: "text-xs font-semibold text-slate-700 hover:text-slate-900" %>
                    <% if reservation.status == "pending" %>
                      <%= link_to "Confirm", confirm_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Confirm this reservation?" }, class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700" %>
                    <% end %>
                    <% if reservation.status == "confirmed" %>
                      <%= link_to "Complete", complete_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Mark as completed?" }, class: "text-xs font-semibold text-sky-600 hover:text-sky-700" %>
                    <% end %>
                    <% if reservation.status != "cancelled" %>
                      <%= link_to "Cancel", cancel_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Cancel this reservation?" }, class: "text-xs font-semibold text-rose-600 hover:text-rose-700" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-3 p-3 md:hidden">
        <% @dining_reservations.each do |reservation| %>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-800"><%= reservation.name %></p>
                <p class="mt-1 text-xs text-slate-500"><%= reservation.reservation_date.strftime("%d %b %Y") %> • <%= reservation.reservation_time.to_s.gsub(/(\d{2})(\d{2})/, '\1:\2') %></p>
              </div>
              <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= status_badge_class(reservation.status) %>">
                <%= reservation.status.titleize %>
              </span>
            </div>

            <div class="mt-3 space-y-2 text-xs text-slate-600">
              <div class="flex justify-between gap-3"><span>Guests</span><span class="font-medium text-slate-800"><%= reservation.number_of_guests %></span></div>
              <div class="flex justify-between gap-3"><span>Email</span><span class="font-medium text-slate-800 text-right"><%= reservation.email %></span></div>
              <div class="flex justify-between gap-3"><span>Phone</span><span class="font-medium text-slate-800 text-right"><%= reservation.phone %></span></div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <%= link_to "View", admin_dining_reservation_path(reservation), class: "inline-flex flex-1 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700" %>
              <% if reservation.status == "pending" %>
                <%= link_to "Confirm", confirm_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Confirm this reservation?" }, class: "inline-flex flex-1 items-center justify-center rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
              <% if reservation.status == "confirmed" %>
                <%= link_to "Complete", complete_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Mark as completed?" }, class: "inline-flex flex-1 items-center justify-center rounded-lg bg-sky-600 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
              <% if reservation.status != "cancelled" %>
                <%= link_to "Cancel", cancel_admin_dining_reservation_path(reservation), data: { turbo_method: :patch, turbo_confirm: "Cancel this reservation?" }, class: "inline-flex flex-1 items-center justify-center rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-20 text-center">
        <p class="text-3xl mb-2">🍽️</p>
        <p class="text-sm text-slate-400">No dining reservations found.</p>
      </div>
    <% end %>
  </div>
</div>
