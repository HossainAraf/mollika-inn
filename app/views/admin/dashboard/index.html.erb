<% content_for :page_title, "Dashboard" %>

<div class="space-y-6">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Arrivals</p>
          <p class="mt-2 text-2xl font-bold text-slate-900"><%= @today_arrivals.size %></p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-lg text-slate-600">🛎</div>
      </div>
      <p class="mt-3 text-xs text-slate-500">Expected check-ins</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Departures</p>
          <p class="mt-2 text-2xl font-bold text-slate-900"><%= @today_departures.size %></p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-lg text-slate-600">🚪</div>
      </div>
      <p class="mt-3 text-xs text-slate-500">Expected check-outs</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Pending</p>
          <p class="mt-2 text-2xl font-bold text-slate-900"><%= @pending_bookings.size %></p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-lg text-slate-600">⏳</div>
      </div>
      <p class="mt-3 text-xs text-slate-500">Awaiting confirmation</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Inquiries</p>
          <p class="mt-2 text-2xl font-bold text-slate-900"><%= @unread_inquiries %></p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-lg text-slate-600">✉️</div>
      </div>
      <p class="mt-3 text-xs text-slate-500">Unread messages</p>
    </div>
  </div>

  <% if @revenue_this_week.any? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-800">Revenue this week</h2>
        <span class="text-sm font-medium text-slate-500">৳<%= number_with_delimiter(@revenue_this_week.values.sum.to_i) %></span>
      </div>
      <div class="flex items-end gap-2 h-28">
        <% max_rev = [@revenue_this_week.values.max, 1].max %>
        <% @revenue_this_week.each do |day, amount| %>
          <div class="flex flex-1 flex-col items-center gap-2">
            <span class="text-[11px] text-slate-500">৳<%= number_with_delimiter(amount.to_i) %></span>
            <div class="w-full rounded-t-md bg-slate-900" style="height:<%= [(amount.to_f / max_rev * 100).to_i, 6].max %>%; min-height:8px;"></div>
            <span class="text-[11px] text-slate-400"><%= day.strftime("%a") %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-800">Room occupancy</h2>
        <%= link_to "Manage rooms", admin_rooms_path, class: "text-xs font-medium text-slate-600 hover:text-slate-900" %>
      </div>

      <% if @occupancy_data.any? %>
        <div class="space-y-4">
          <% @occupancy_data.each do |item| %>
            <div>
              <div class="mb-1 flex items-center justify-between text-sm">
                <span class="font-medium text-slate-700"><%= item[:room_type] %></span>
                <span class="text-slate-500"><%= item[:occupied] %>/<%= item[:total] %></span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                <div class="h-full rounded-full bg-slate-900" style="width:<%= item[:total] > 0 ? (item[:occupied].to_f / item[:total] * 100).to_i : 0 %>%;"></div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">No occupancy data.</p>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-3">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-800">Recent bookings</h2>
        <%= link_to "View all", admin_bookings_path, class: "text-xs font-medium text-slate-600 hover:text-slate-900" %>
      </div>

      <% if @recent_bookings.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
                <th class="pb-2 pr-3">Ref</th>
                <th class="pb-2 pr-3">Guest</th>
                <th class="pb-2 pr-3">Dates</th>
                <th class="pb-2 pr-3">Status</th>
                <th class="pb-2">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_bookings.each do |booking| %>
                <tr class="border-b border-slate-100">
                  <td class="py-2.5 pr-3">
                    <%= link_to "#MIB-#{booking.id.to_s.rjust(4,'0')}", admin_booking_path(booking), class: "font-mono text-xs font-semibold text-slate-700 hover:text-slate-900" %>
                  </td>
                  <td class="py-2.5 pr-3 text-slate-700"><%= booking.display_guest_name %></td>
                  <td class="py-2.5 pr-3 text-xs text-slate-500"><%= booking.check_in_date.strftime("%d %b") %> - <%= booking.check_out_date.strftime("%d %b") %></td>
                  <td class="py-2.5 pr-3">
                    <% badge_colors = { "pending" => "bg-amber-100 text-amber-700", "confirmed" => "bg-sky-100 text-sky-700", "checked_in" => "bg-emerald-100 text-emerald-700", "checked_out" => "bg-slate-200 text-slate-700", "cancelled" => "bg-rose-100 text-rose-700" } %>
                    <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= badge_colors[booking.status] || 'bg-slate-100 text-slate-600' %>"><%= booking.status.titleize %></span>
                  </td>
                  <td class="py-2.5 text-sm font-medium text-slate-800">৳<%= number_with_delimiter(booking.total_amount.to_i) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-8 text-center text-sm text-slate-400">No bookings yet.</p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <%= link_to admin_bookings_path, class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <div class="mb-3 text-2xl">📅</div>
      <p class="text-sm font-semibold text-slate-800">Bookings</p>
      <p class="mt-1 text-xs text-slate-500"><%= @booking_count %> total</p>
    <% end %>

    <%= link_to admin_rooms_path, class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <div class="mb-3 text-2xl">🛏</div>
      <p class="text-sm font-semibold text-slate-800">Rooms</p>
      <p class="mt-1 text-xs text-slate-500"><%= @room_count %> total</p>
    <% end %>

    <%= link_to admin_guests_path, class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <div class="mb-3 text-2xl">👥</div>
      <p class="text-sm font-semibold text-slate-800">Guests</p>
      <p class="mt-1 text-xs text-slate-500"><%= @guest_count %> registered</p>
    <% end %>

    <%= link_to admin_contact_inquiries_path, class: "rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <div class="mb-3 text-2xl">✉️</div>
      <p class="text-sm font-semibold text-slate-800">Inquiries</p>
      <p class="mt-1 text-xs text-slate-500"><%= @unread_inquiries %> unread</p>
    <% end %>
  </div>
</div>
