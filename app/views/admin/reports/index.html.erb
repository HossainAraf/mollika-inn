<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Reports</h1>
    <p class="mt-1 text-sm text-gray-500">Insights and export tools</p>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <%= link_to occupancy_admin_reports_path, class: "rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <p class="text-sm font-semibold text-slate-700">Occupancy</p>
      <p class="mt-2 text-xs text-slate-500">Monitor room occupancy trends</p>
    <% end %>

    <%= link_to revenue_admin_reports_path, class: "rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <p class="text-sm font-semibold text-slate-700">Revenue</p>
      <p class="mt-2 text-xs text-slate-500">Review revenue performance</p>
    <% end %>

    <%= link_to bookings_export_admin_reports_path, class: "rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
      <p class="text-sm font-semibold text-slate-700">Bookings CSV</p>
      <p class="mt-2 text-xs text-slate-500">Export bookings as CSV</p>
    <% end %>
  </div>
</div>