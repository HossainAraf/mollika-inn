<h1>Settings</h1>

<%= form_with url: admin_settings_path, method: :patch do %>
  <% @settings.each do |setting| %>
    <div>
      <label><%= setting.key %></label><br>
      <%= text_field_tag "settings[#{setting.key}]", setting.value %>
    </div>
  <% end %>
  <div><%= submit_tag "Save Settings" %></div>
<% end %>