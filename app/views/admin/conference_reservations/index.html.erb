<% content_for :page_title, "Conference Reservations" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Conference Reservations</h1>
      <p class="mt-1 text-sm text-slate-500"><%= @conference_reservations.count %> event requests found</p>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Pending</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @conference_reservations.count { |r| r.status == "pending" } %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Confirmed</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @conference_reservations.count { |r| r.status == "confirmed" } %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">Cancelled</p>
      <p class="mt-2 text-2xl font-bold text-slate-900"><%= @conference_reservations.count { |r| r.status == "cancelled" } %></p>
    </div>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @conference_reservations.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
              <th class="px-5 py-3">Date</th>
              <th class="px-4 py-3">Contact</th>
              <th class="px-4 py-3">Organization</th>
              <th class="px-4 py-3">Attendees</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @conference_reservations.each do |r| %>
              <tr class="border-t border-slate-100 hover:bg-slate-50 align-top">
                <td class="px-5 py-3 text-slate-700"><%= r.event_date %></td>
                <td class="px-4 py-3 text-slate-700">
                  <div class="font-medium"><%= r.display_contact %></div>
                  <div class="text-xs text-slate-500"><%= r.email %></div>
                </td>
                <td class="px-4 py-3 text-slate-700"><%= r.organization_name.presence || "—" %></td>
                <td class="px-4 py-3 text-slate-700"><%= r.attendees %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= status_badge_class(r.status) %>">
                    <%= r.status.titleize %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", admin_conference_reservation_path(r), class: "text-xs font-semibold text-slate-700 hover:text-slate-900" %>
                    <% if r.status != "confirmed" %>
                      <%= button_to "Confirm", confirm_admin_conference_reservation_path(r), method: :patch, class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700 bg-transparent border-0 p-0" %>
                    <% end %>
                    <% if r.status != "cancelled" %>
                      <%= button_to "Cancel", cancel_admin_conference_reservation_path(r), method: :patch, data: { confirm: "Are you sure?" }, class: "text-xs font-semibold text-rose-600 hover:text-rose-700 bg-transparent border-0 p-0" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="space-y-3 p-3 md:hidden">
        <% @conference_reservations.each do |r| %>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-800"><%= r.display_contact %></p>
                <p class="mt-1 text-xs text-slate-500"><%= r.event_date %></p>
              </div>
              <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-semibold <%= status_badge_class(r.status) %>">
                <%= r.status.titleize %>
              </span>
            </div>

            <div class="mt-3 space-y-2 text-xs text-slate-600">
              <div class="flex justify-between gap-3"><span>Organization</span><span class="font-medium text-slate-800 text-right"><%= r.organization_name.presence || "—" %></span></div>
              <div class="flex justify-between gap-3"><span>Attendees</span><span class="font-medium text-slate-800"><%= r.attendees %></span></div>
              <div class="flex justify-between gap-3"><span>Email</span><span class="font-medium text-slate-800 text-right"><%= r.email %></span></div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <%= link_to "View", admin_conference_reservation_path(r), class: "inline-flex flex-1 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700" %>
              <% if r.status != "confirmed" %>
                <%= button_to "Confirm", confirm_admin_conference_reservation_path(r), method: :patch, class: "inline-flex flex-1 items-center justify-center rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
              <% if r.status != "cancelled" %>
                <%= button_to "Cancel", cancel_admin_conference_reservation_path(r), method: :patch, data: { confirm: "Are you sure?" }, class: "inline-flex flex-1 items-center justify-center rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-20 text-center">
        <p class="text-3xl mb-2">🏢</p>
        <p class="text-sm text-slate-400">No conference reservations found.</p>
      </div>
    <% end %>
  </div>
</div>
