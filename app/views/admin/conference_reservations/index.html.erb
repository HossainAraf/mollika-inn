<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Conference Reservations</h1>
    <p class="mt-1 text-sm text-gray-500">Manage event requests and approvals</p>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] text-sm">
        <thead class="bg-slate-50">
          <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400">
            <th class="px-4 py-3">Date</th>
            <th class="px-4 py-3">Contact</th>
            <th class="px-4 py-3">Organization</th>
            <th class="px-4 py-3">Attendees</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @conference_reservations.each do |r| %>
            <tr class="border-t border-slate-100 hover:bg-slate-50 align-top">
              <td class="px-4 py-3 text-slate-700"><%= r.event_date %></td>
              <td class="px-4 py-3 text-slate-700">
                <div class="font-medium"><%= r.display_contact %></div>
                <div class="text-xs text-slate-500"><%= r.email %></div>
              </td>
              <td class="px-4 py-3 text-slate-700"><%= r.organization_name.presence || "—" %></td>
              <td class="px-4 py-3 text-slate-700"><%= r.attendees %></td>
              <td class="px-4 py-3 text-slate-700"><%= r.status %></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                  <%= link_to "View", admin_conference_reservation_path(r), class: "btn-secondary w-full sm:w-auto text-center" %>
                  <% if r.status != "confirmed" %>
                    <%= button_to "Confirm", confirm_admin_conference_reservation_path(r), method: :patch, class: "btn-primary w-full sm:w-auto" %>
                  <% end %>
                  <% if r.status != "cancelled" %>
                    <%= button_to "Cancel", cancel_admin_conference_reservation_path(r), method: :patch, data: { confirm: "Are you sure?" }, class: "btn-secondary w-full sm:w-auto" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
