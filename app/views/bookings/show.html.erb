<div class="min-h-screen bg-stone-50 flex items-center justify-center py-16 px-4">
  <div class="max-w-lg w-full">

    <%# Success Icon %>
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto mb-4" style="background:#e8f5e9;">✅</div>
      <h1 class="font-serif text-3xl font-bold text-gray-900">Booking Received!</h1>
      <p class="text-gray-500 mt-2">Thank you, <%= @booking.display_guest_name.split.first %>. We will confirm your booking shortly.</p>
    </div>

    <%# Booking Card %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
      <div class="p-5 text-white" style="background:#1a3a2a;">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-green-300 text-xs uppercase tracking-widest">Booking Reference</p>
            <p class="font-mono text-xl font-bold mt-0.5">#MIB-<%= @booking.id.to_s.rjust(5, '0') %></p>
          </div>
          <div class="text-right">
            <span class="bg-yellow-400 text-gray-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
              <%= @booking.status.titleize %>
            </span>
          </div>
        </div>
      </div>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Guest</p>
            <p class="font-semibold text-gray-800 mt-0.5"><%= @booking.display_guest_name %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Email</p>
            <p class="font-semibold text-gray-800 mt-0.5 text-sm"><%= @booking.guest.email %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Check-in</p>
            <p class="font-semibold text-gray-800 mt-0.5"><%= @booking.check_in_date.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Check-out</p>
            <p class="font-semibold text-gray-800 mt-0.5"><%= @booking.check_out_date.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Nights</p>
            <p class="font-semibold text-gray-800 mt-0.5"><%= @booking.nights %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">Guests</p>
            <p class="font-semibold text-gray-800 mt-0.5"><%= @booking.num_adults %> adult<%= @booking.num_adults > 1 ? 's' : '' %><%= @booking.num_children > 0 ? ", #{@booking.num_children} child#{@booking.num_children > 1 ? 'ren' : ''}" : '' %></p>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
          <p class="text-sm text-gray-500">Total Amount</p>
          <p class="text-2xl font-bold" style="color:#1a3a2a;">৳<%= number_with_delimiter(@booking.total_amount.to_i) %></p>
        </div>
        <% if @booking.special_requests.present? %>
          <div class="bg-stone-50 rounded-lg p-3">
            <p class="text-xs text-gray-400 font-medium mb-1">Special Requests</p>
            <p class="text-sm text-gray-600"><%= @booking.special_requests %></p>
          </div>
        <% end %>
      </div>
    </div>

    <%# What's Next %>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 mb-6">
      <h3 class="font-semibold text-gray-800 mb-3 text-sm uppercase tracking-wide">What Happens Next</h3>
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full text-white text-xs flex items-center justify-center shrink-0 mt-0.5" style="background:#c9973e;">1</span>
          <p class="text-sm text-gray-600">Our team reviews your booking and sends a confirmation to <strong><%= @booking.guest.email %></strong> within 2 hours.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full text-white text-xs flex items-center justify-center shrink-0 mt-0.5" style="background:#c9973e;">2</span>
          <p class="text-sm text-gray-600">Arrive on <strong><%= @booking.check_in_date.strftime("%d %b") %></strong> from 2:00 PM. Show your booking reference at the front desk.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full text-white text-xs flex items-center justify-center shrink-0 mt-0.5" style="background:#c9973e;">3</span>
          <p class="text-sm text-gray-600">Payment is collected at check-in. We accept cash and mobile banking.</p>
        </div>
      </div>
    </div>

    <div class="flex gap-3">
      <%= link_to "Back to Home", root_path, class: "flex-1 text-center py-3 rounded-xl border-2 font-semibold text-sm transition-colors", style: "border-color:#1a3a2a; color:#1a3a2a;" %>
      <%= link_to "Browse More Rooms", rooms_path, class: "flex-1 text-center py-3 rounded-xl font-semibold text-sm text-white", style: "background:#1a3a2a;" %>
    </div>
  </div>
</div>
