<h1>Edit Profile</h1>

<%= form_with model: @guest, url: guests_profile_path, method: :patch do |f| %>
  <div><%= f.label :first_name %><br><%= f.text_field :first_name %></div>
  <div><%= f.label :last_name %><br><%= f.text_field :last_name %></div>
  <div><%= f.label :phone %><br><%= f.text_field :phone %></div>
  <div><%= f.label :address %><br><%= f.text_area :address %></div>
  <div><%= f.label :nationality %><br><%= f.text_field :nationality %></div>
  <div><%= f.submit "Update" %></div>
<% end %>