<h1>Booking #<%= @booking.id %></h1>

<p>Status: <%= @booking.status %></p>
<p>Dates: <%= @booking.check_in_date %> to <%= @booking.check_out_date %></p>

<% if %w[pending confirmed].include?(@booking.status) %>
  <%= button_to "Cancel Booking", cancel_guests_booking_path(@booking), method: :patch, data: { turbo_confirm: "Are you sure?" } %>
<% end %>