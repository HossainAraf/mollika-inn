<%# Header %>
<div class="py-16 text-center text-white" style="background: linear-gradient(135deg, #1a3a2a 0%, #2d5a3d 100%);">
  <p class="text-yellow-400 text-xs uppercase tracking-[0.3em] mb-2 font-medium">Photo Gallery</p>
  <h1 class="font-serif text-4xl md:text-5xl font-bold">A Glimpse of Mollika Inn</h1>
  <p class="text-green-200 mt-3 max-w-lg mx-auto">Browse our rooms, property, and facilities through the lens.</p>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <%
    # Curated hotel photos per album
    album_images = {
      "Rooms & Suites" => [
        "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=700&q=80",
        "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=500&q=80",
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?w=500&q=80",
        "https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=500&q=80",
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=500&q=80",
        "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?w=500&q=80"
      ],
      "Property & Grounds" => [
        "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=700&q=80",
        "https://images.unsplash.com/photo-1564501049412-61c2a3083791?w=500&q=80",
        "https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?w=500&q=80",
        "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=500&q=80"
      ],
      "Restaurant & Dining" => [
        "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=700&q=80",
        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=500&q=80",
        "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&q=80"
      ]
    }
    fallback_images = [
      "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80",
      "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600&q=80",
      "https://images.unsplash.com/photo-1590490360182-c33d57733427?w=600&q=80"
    ]
  %>

  <% if @albums.any? %>
    <% @albums.each_with_index do |album, ai| %>
      <section class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="font-serif text-2xl font-bold text-gray-900"><%= album.name %></h2>
            <% if album.description.present? %>
              <p class="text-gray-500 text-sm mt-0.5"><%= album.description %></p>
            <% end %>
          </div>
          <span class="text-xs text-gray-400 bg-gray-100 px-3 py-1.5 rounded-full"><%= album.gallery_images.count %> photos</span>
        </div>

        <% images = album_images[album.name] || fallback_images %>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          <% album.gallery_images.each_with_index do |img, idx| %>
            <% img_url = images[idx % images.length] %>
            <div class="group relative overflow-hidden rounded-xl <%= idx == 0 ? 'col-span-2' : '' %>" style="height:<%= idx == 0 ? '300px' : '180px' %>;">
              <img src="<%= img_url %>"
                   alt="<%= img.caption.presence || album.name %>"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all flex items-end p-3 opacity-0 group-hover:opacity-100">
                <% if img.caption.present? %>
                  <span class="text-white text-xs font-medium bg-black/50 px-2 py-1 rounded-full"><%= img.caption %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="text-center py-20">
      <p class="text-5xl mb-4">🖼</p>
      <p class="text-gray-500">No gallery photos yet.</p>
    </div>
  <% end %>

  <div class="text-center mt-4">
    <%= link_to "Book Your Stay →", rooms_path, class: "btn-primary" %>
  </div>
</div>
