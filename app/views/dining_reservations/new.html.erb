<%# Header %>
<div class="py-16 text-center text-white" style="background: linear-gradient(135deg, #1a3a2a 0%, #2d5a3d 100%);">
  <p class="text-yellow-400 text-xs uppercase tracking-[0.3em] mb-2 font-medium">Reservations</p>
  <h1 class="font-serif text-4xl md:text-5xl font-bold">Book a Table</h1>
  <p class="text-green-200 mt-3 max-w-lg mx-auto">Reserve your dining experience at Mollika Inn</p>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="bg-white rounded-2xl p-8 shadow-sm">
    <%= form_with model: @dining_reservation, url: dining_reservations_path, local: true do |f| %>
      <% if @dining_reservation.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
          <h3 class="font-semibold text-red-800 mb-2">Please fix the following errors:</h3>
          <ul class="list-disc list-inside text-red-700 text-sm">
            <% @dining_reservation.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <%= f.label :name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :phone, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <%= f.label :reservation_date, "Date", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :reservation_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
        </div>
        <div>
          <%= f.label :reservation_time, "Time (HHMM format, e.g., 1900 for 7:00 PM)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :reservation_time, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :number_of_guests, "Number of Guests", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.number_field :number_of_guests, min: 1, max: 50, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", required: true %>
      </div>

      <div class="mb-6">
        <%= f.label :special_requests, "Special Requests (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :special_requests, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none", placeholder: "Any dietary requirements, special occasions, etc." %>
      </div>

      <div class="flex flex-col sm:flex-row gap-4">
        <%= f.submit "Submit Reservation", class: "flex-1 bg-inn text-white font-semibold px-6 py-3 rounded-lg hover:bg-inn-dark transition-colors cursor-pointer", style: "background:#1a3a2a;" %>
        <%= link_to "Cancel", menu_index_path, class: "flex-1 text-center px-6 py-3 rounded-lg border-2 border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
