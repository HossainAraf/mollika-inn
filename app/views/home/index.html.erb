<%# ── Hero ──────────────────────────────────────────────────── %>
<section class="relative min-h-screen flex items-center justify-center overflow-hidden" style="background: linear-gradient(135deg, #0f2219 0%, #1a3a2a 40%, #2d5a3d 100%);">
  <div class="hero-bg absolute inset-0"></div>
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <p class="text-yellow-400 text-sm uppercase tracking-[0.3em] mb-4 font-medium">Welcome to</p>
    <h1 class="font-serif text-5xl md:text-7xl font-bold text-white mb-4 leading-tight">Hotel Moli Inn</h1>
    <p class="text-green-200 text-lg md:text-xl mb-2 font-light tracking-wide">Naogaon, Bangladesh</p>
    <p class="text-green-300 text-base mb-10 max-w-xl mx-auto leading-relaxed opacity-90">Where comfort meets warmth. A handpicked retreat in the heart of Naogaon, with attentive service and rooms designed for rest.</p>
    <%# Search Form %>
    <div class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl p-6 max-w-2xl mx-auto">
      <p class="text-gray-500 text-xs uppercase tracking-widest mb-4 font-semibold">Check Availability</p>
      <%= form_with url: rooms_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
        <div class="flex-1">
          <label class="block text-xs text-gray-500 mb-1 font-medium">Check-in</label>
          <%= f.date_field :check_in, value: @check_in, min: Date.today, class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none" %>
        </div>
        <div class="flex-1">
          <label class="block text-xs text-gray-500 mb-1 font-medium">Check-out</label>
          <%= f.date_field :check_out, value: @check_out, min: Date.today + 1, class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none" %>
        </div>
        <%= f.submit "Search Rooms →", class: "bg-inn text-white font-semibold px-6 py-2.5 rounded-lg hover:bg-inn-dark transition-colors cursor-pointer text-sm sm:self-end", style: "background:#1a3a2a;" %>
      <% end %>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
  </div>
</section>

<%# ── Stats Strip ────────────────────────────────────────────── %>
<section class="bg-white border-y border-gray-100">
  <div class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    <div>
      <p class="text-3xl font-bold" style="color:#1a3a2a;">13+</p>
      <p class="text-sm text-gray-500 mt-1">Rooms Available</p>
    </div>
    <div>
      <p class="text-3xl font-bold" style="color:#1a3a2a;">24/7</p>
      <p class="text-sm text-gray-500 mt-1">Front Desk Service</p>
    </div>
    <div>
      <p class="text-3xl font-bold" style="color:#1a3a2a;">4.9★</p>
      <p class="text-sm text-gray-500 mt-1">Guest Rating</p>
    </div>
    <div>
      <p class="text-3xl font-bold" style="color:#1a3a2a;">Free</p>
      <p class="text-sm text-gray-500 mt-1">Wi-Fi Included</p>
    </div>
  </div>
</section>

<%# ── Room Types ─────────────────────────────────────────────── %>
<section class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-yellow-600 text-xs uppercase tracking-[0.25em] font-semibold mb-2">Accommodation</p>
      <h2 class="section-title text-4xl mb-3">Our Rooms</h2>
      <p class="text-gray-500 max-w-xl mx-auto">From cosy single rooms to spacious family suites — every room is kept immaculately clean and stocked with everything you need.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% room_images = {
        "single-room" => "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80",
        "double-room" => "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600&q=80",
        "deluxe-room" => "https://images.unsplash.com/photo-1590490360182-c33d57733427?w=600&q=80",
        "family-room" => "https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=600&q=80"
      } %>
      <% @room_types.each do |rt| %>
        <div class="card group">
          <div class="relative overflow-hidden h-48">
            <img src="<%= room_images[rt.slug] || "https://picsum.photos/seed/#{rt.slug}/600/400" %>"
                 alt="<%= rt.name %>"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 onerror="this.src='https://picsum.photos/seed/hotelroom/600/400'">
            <div class="absolute top-3 right-3 bg-white/90 rounded-full px-2 py-1 text-xs font-semibold" style="color:#1a3a2a;">
              Up to <%= rt.max_occupancy %> guests
            </div>
          </div>
          <div class="p-5">
            <h3 class="font-serif font-bold text-lg text-gray-900 mb-1"><%= rt.name %></h3>
            <p class="text-gray-500 text-sm mb-3 line-clamp-2 leading-relaxed"><%= rt.description.truncate(90) %></p>
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs text-gray-400">From</span>
                <p class="font-bold text-lg" style="color:#1a3a2a;">৳<%= number_with_delimiter(rt.base_price_per_night.to_i) %><span class="text-xs font-normal text-gray-400">/night</span></p>
              </div>
              <%= link_to "View Room →", room_path(rt.slug), class: "text-sm font-semibold hover:underline", style: "color:#c9973e;" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-10">
      <%= link_to "View All Rooms", rooms_path, class: "btn-outline" %>
    </div>
  </div>
</section>

<%# ── Facilities ─────────────────────────────────────────────── %>
<% if @facilities.any? %>
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <p class="text-yellow-600 text-xs uppercase tracking-[0.25em] font-semibold mb-2">What We Offer</p>
      <h2 class="section-title text-4xl">Facilities & Services</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
      <% @facilities.each do |f| %>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-stone-50 hover:bg-stone-100 transition-colors">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 text-xl" style="background:#e8f5e9;">
            <%= { "wifi" => "📶", "pool" => "🏊", "restaurant" => "🍽", "spa" => "💆", "gym" => "💪", "car" => "🚗", "lock" => "🔒", "leaf" => "🌿", "bell" => "🛎", "fork" => "🍴", "shirt" => "👕", "broom" => "🧹", "map" => "🗺", "tray" => "🍱", "snowflake" => "❄️", "coffee" => "☕", "mug" => "☕" }[f.icon_name] || "✦" %>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-800"><%= f.name %></p>
            <p class="text-xs text-gray-500 mt-0.5 leading-snug line-clamp-2"><%= f.description %></p>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-8">
      <%= link_to "All Facilities →", facilities_path, class: "text-sm font-semibold hover:underline", style: "color:#c9973e;" %>
    </div>
  </div>
</section>
<% end %>

<%# ── Dining Section ──────────────────────────────────────────── %>
<% if @dining_facilities.any? %>
<section class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-yellow-600 text-xs uppercase tracking-[0.25em] font-semibold mb-2">Taste of Mollika</p>
      <h2 class="section-title text-4xl mb-3">Dining Experience</h2>
      <p class="text-gray-500 max-w-xl mx-auto">From authentic Bengali cuisine to continental favorites, our restaurant offers a delightful culinary journey.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <% @dining_facilities.each do |dining| %>
        <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-start gap-4">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shrink-0" style="background:#e8f5e9;">
              <%= { "fork" => "🍴", "tray" => "🍱", "coffee" => "☕", "mug" => "☕", "restaurant" => "🍽" }[dining.icon_name] || "🍽" %>
            </div>
            <div class="flex-1">
              <h3 class="font-serif font-bold text-xl text-gray-900 mb-2"><%= dining.name %></h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-4"><%= dining.description %></p>
              <div class="flex flex-wrap gap-2">
                <%= link_to "View Menu", menu_index_path, class: "px-4 py-2 text-sm font-semibold rounded-lg border-2 transition-colors hover:bg-white", style: "border-color:#1a3a2a; color:#1a3a2a;" %>
                <%= link_to "Book Table", new_dining_reservation_path, class: "px-4 py-2 text-sm font-semibold rounded-lg text-white transition-colors", style: "background:#1a3a2a;" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Sample Menu Preview %>
    <div class="bg-white rounded-2xl p-8 shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-serif text-2xl font-bold text-gray-900">Sample Menu Highlights</h3>
        <%= link_to "View Full Menu →", menu_index_path, class: "text-sm font-semibold hover:underline", style: "color:#c9973e;" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border-b border-gray-100 pb-4">
          <h4 class="font-semibold text-gray-900 mb-3">Bengali Specialties</h4>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex justify-between"><span>Kacchi Biryani</span><span class="font-medium" style="color:#1a3a2a;">৳350</span></li>
            <li class="flex justify-between"><span>Hilsa Fish Curry</span><span class="font-medium" style="color:#1a3a2a;">৳280</span></li>
            <li class="flex justify-between"><span>Beef Bhuna</span><span class="font-medium" style="color:#1a3a2a;">৳220</span></li>
            <li class="flex justify-between"><span>Mutton Rezala</span><span class="font-medium" style="color:#1a3a2a;">৳320</span></li>
          </ul>
        </div>
        <div class="border-b border-gray-100 pb-4">
          <h4 class="font-semibold text-gray-900 mb-3">Continental</h4>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex justify-between"><span>Grilled Chicken</span><span class="font-medium" style="color:#1a3a2a;">৳280</span></li>
            <li class="flex justify-between"><span>Pasta Alfredo</span><span class="font-medium" style="color:#1a3a2a;">৳240</span></li>
            <li class="flex justify-between"><span>Fish & Chips</span><span class="font-medium" style="color:#1a3a2a;">৳260</span></li>
            <li class="flex justify-between"><span>Club Sandwich</span><span class="font-medium" style="color:#1a3a2a;">৳180</span></li>
          </ul>
        </div>
        <div class="border-b border-gray-100 pb-4">
          <h4 class="font-semibold text-gray-900 mb-3">Beverages</h4>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex justify-between"><span>Masala Chai</span><span class="font-medium" style="color:#1a3a2a;">৳40</span></li>
            <li class="flex justify-between"><span>Fresh Lime Soda</span><span class="font-medium" style="color:#1a3a2a;">৳60</span></li>
            <li class="flex justify-between"><span>Mango Lassi</span><span class="font-medium" style="color:#1a3a2a;">৳80</span></li>
            <li class="flex justify-between"><span>Coffee</span><span class="font-medium" style="color:#1a3a2a;">৳70</span></li>
          </ul>
        </div>
      </div>
    </div>

    <%# Dining Actions CTA %>
    <div class="mt-12 text-center bg-white rounded-2xl p-8 shadow-sm">
      <h3 class="font-serif text-2xl font-bold text-gray-900 mb-3">Hungry? We're Here to Serve</h3>
      <p class="text-gray-500 mb-6">Open daily from 7:00 AM to 11:00 PM. Room service available until 10:00 PM.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to "View Full Menu", menu_index_path, class: "px-6 py-3 font-semibold rounded-lg border-2 transition-colors hover:bg-white", style: "border-color:#1a3a2a; color:#1a3a2a;" %>
        <%= link_to "Book a Table", new_dining_reservation_path, class: "px-6 py-3 font-semibold rounded-lg text-white transition-colors", style: "background:#1a3a2a;" %>
        <%= link_to "Book a Room", rooms_path, class: "px-6 py-3 font-semibold rounded-lg transition-colors", style: "background:#c9973e; color:white;" %>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# ── Reviews ─────────────────────────────────────────────────── %>
<% if @reviews.any? %>
<section class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-yellow-600 text-xs uppercase tracking-[0.25em] font-semibold mb-2">Guest Reviews</p>
      <h2 class="section-title text-4xl">What Guests Say</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% @reviews.each do |review| %>
        <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex mb-3">
            <% review.rating.times do %><span class="star text-lg">★</span><% end %>
          </div>
          <h4 class="font-semibold text-gray-900 mb-2 leading-snug"><%= review.title %></h4>
          <p class="text-sm text-gray-500 leading-relaxed line-clamp-4"><%= review.body %></p>
          <div class="mt-4 pt-4 border-t border-gray-100 flex items-center gap-2">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white" style="background:#1a3a2a;"><%= review.guest.first_name[0] %></div>
            <div>
              <p class="text-sm font-medium text-gray-800"><%= review.guest.full_name %></p>
              <p class="text-xs text-gray-400"><%= review.guest.nationality %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# ── CTA ─────────────────────────────────────────────────────── %>
<section class="py-16 text-center text-white" style="background: linear-gradient(135deg, #1a3a2a 0%, #2d5a3d 100%);">
  <div class="max-w-2xl mx-auto px-4">
    <h2 class="font-serif text-4xl font-bold mb-4">Ready to Book Your Stay?</h2>
    <p class="text-green-200 mb-8 text-lg">Call us directly or browse our rooms online. We look forward to welcoming you.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Browse Rooms", rooms_path, class: "btn-primary" %>
      <%= link_to "Contact Us", contact_path, class: "btn-outline border-white text-white hover:bg-white hover:text-inn" %>
    </div>
  </div>
</section>
