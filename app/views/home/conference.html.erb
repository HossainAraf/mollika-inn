<%# Conference & Event Venue %>
<div class="py-16 text-center text-white" style="background: linear-gradient(135deg, #1a3a2a 0%, #2d5a3d 100%);">
  <p class="text-yellow-400 text-xs uppercase tracking-[0.3em] mb-2 font-medium">At Mollika Inn</p>
  <h1 class="font-serif text-4xl md:text-5xl font-bold">Conference & Event Venue</h1>
  <p class="text-green-200 mt-3 max-w-lg mx-auto">Premium meeting spaces designed for productivity and success.</p>
</div>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <%# Conference Overview %>
  <div class="mb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-serif text-3xl font-bold text-gray-900 mb-4">Where Business Meets Comfort</h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          Our state-of-the-art conference and event venue offers the perfect setting for corporate meetings, 
          seminars, workshops, team-building sessions, and social gatherings. With flexible layouts and 
          modern amenities, we ensure every event is a resounding success.
        </p>
        
        <% if @facility && @facility.persisted? %>
          <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-6">
            <h3 class="font-semibold text-gray-900 mb-2"><%= @facility.name %></h3>
            <p class="text-gray-600"><%= simple_format(@facility.description) %></p>
          </div>
        <% end %>
        
        <div class="flex flex-wrap gap-4">
          <%= link_to "Book a Venue →", new_booking_path, class: "btn-primary inline-flex items-center" %>
          <%= link_to "View Facilities →", facilities_path, class: "btn-secondary inline-flex items-center" %>
        </div>
      </div>
      
      <div class="relative">
        <div class="aspect-video bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-8 flex items-center justify-center border-2 border-dashed border-green-300">
          <div class="text-center">
            <div class="text-6xl mb-4">🏢</div>
            <p class="text-gray-500 text-sm">Conference venue image</p>
            <p class="text-gray-400 text-xs mt-1">(Add your venue photo here)</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Key Features Section %>
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-8">
      <div class="h-px flex-1 bg-gray-200"></div>
      <h2 class="font-semibold text-xs uppercase tracking-[0.25em] text-gray-400 px-2">Key Features</h2>
      <div class="h-px flex-1 bg-gray-200"></div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          📐
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Flexible Layouts</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Customizable setups from small board meetings (10-15 people) to large seminars (100+ attendees).</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          📡
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Tech-Ready</h3>
        <p class="text-sm text-gray-500 leading-relaxed">4K projector, premium sound system, wireless microphones, and video conferencing capabilities.</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          📶
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">High-Speed Wi-Fi</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Dedicated high-speed internet connection for seamless presentations and streaming.</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          🍽️
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Catering Services</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Customizable catering packages from our rooftop restaurant, including coffee breaks and full meals.</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          🅿️
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Ample Parking</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Free parking for all attendees with dedicated spaces for event organizers.</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4" style="background:#e8f5e9;">
          🤝
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Event Support</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Dedicated event coordinator and technical support staff throughout your event.</p>
      </div>
    </div>
  </div>

  <%# Conference Packages %>
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-8">
      <div class="h-px flex-1 bg-gray-200"></div>
      <h2 class="font-semibold text-xs uppercase tracking-[0.25em] text-gray-400 px-2">Conference Packages</h2>
      <div class="h-px flex-1 bg-gray-200"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl border border-gray-200 p-6 text-center hover:shadow-lg transition-shadow">
        <div class="text-3xl mb-3">📋</div>
        <h3 class="font-semibold text-gray-900 mb-2">Half Day</h3>
        <p class="text-2xl font-bold text-green-700 mb-4">৳2099</p>
        <ul class="text-sm text-gray-600 space-y-2 mb-6">
          <li>✓ 4-hour room rental</li>
          <li>✓ Basic AV equipment</li>
          <li>✓ Coffee break</li>
          <li>✓ Wi-Fi access</li>
        </ul>
        <%= link_to "Book Now", new_booking_path, class: "btn-primary w-full text-center" %>
      </div>
      
      <div class="bg-white rounded-xl border-2 border-green-500 p-6 text-center hover:shadow-lg transition-shadow relative">
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-green-500 text-white text-xs px-3 py-1 rounded-full font-medium">
          Most Popular
        </div>
        <div class="text-3xl mb-3">📋</div>
        <h3 class="font-semibold text-gray-900 mb-2">Full Day</h3>
        <p class="text-2xl font-bold text-green-700 mb-4">৳4099</p>
        <ul class="text-sm text-gray-600 space-y-2 mb-6">
          <li>✓ 8-hour room rental</li>
          <li>✓ Full AV setup</li>
          <li>✓ Coffee breaks & lunch</li>
          <li>✓ Wi-Fi & technical support</li>
          <li>✓ Whiteboard & flipcharts</li>
        </ul>
        <%= link_to "Book Now", new_booking_path, class: "btn-primary w-full text-center" %>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-200 p-6 text-center hover:shadow-lg transition-shadow">
        <div class="text-3xl mb-3">📋</div>
        <h3 class="font-semibold text-gray-900 mb-2">Multi-Day</h3>
        <p class="text-2xl font-bold text-green-700 mb-4">৳8099</p>
        <ul class="text-sm text-gray-600 space-y-2 mb-6">
          <li>✓ 2-day room rental</li>
          <li>✓ Premium AV setup</li>
          <li>✓ All meals & breaks</li>
          <li>✓ Dedicated event coordinator</li>
          <li>✓ Team-building activities</li>
        </ul>
        <%= link_to "Book Now", new_booking_path, class: "btn-primary w-full text-center" %>
      </div>
    </div>
  </div>

  <%# Additional Services %>
  <div class="mb-16">
    <div class="flex items-center gap-3 mb-8">
      <div class="h-px flex-1 bg-gray-200"></div>
      <h2 class="font-semibold text-xs uppercase tracking-[0.25em] text-gray-400 px-2">Additional Services</h2>
      <div class="h-px flex-1 bg-gray-200"></div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-100 p-4 hover:shadow-md transition-shadow text-center">
        <div class="text-2xl mb-2">📝</div>
        <h4 class="font-semibold text-gray-900 text-sm">Event Planning</h4>
        <p class="text-xs text-gray-500 mt-1">Professional planning assistance</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-4 hover:shadow-md transition-shadow text-center">
        <div class="text-2xl mb-2">🖨️</div>
        <h4 class="font-semibold text-gray-900 text-sm">Printing Services</h4>
        <p class="text-xs text-gray-500 mt-1">On-site printing & copying</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-4 hover:shadow-md transition-shadow text-center">
        <div class="text-2xl mb-2">📹</div>
        <h4 class="font-semibold text-gray-900 text-sm">Recording</h4>
        <p class="text-xs text-gray-500 mt-1">Event recording & streaming</p>
      </div>
      
      <div class="bg-white rounded-xl border border-gray-100 p-4 hover:shadow-md transition-shadow text-center">
        <div class="text-2xl mb-2">🎤</div>
        <h4 class="font-semibold text-gray-900 text-sm">Interpretation</h4>
        <p class="text-xs text-gray-500 mt-1">Multi-language interpretation</p>
      </div>
    </div>
  </div>

  <%# CTA %>
  <div class="mt-12 text-center bg-stone-50 rounded-2xl py-12 px-6">
    <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">Plan Your Next Event With Us</h3>
    <p class="text-gray-500 mb-6">Contact our events team for a customized quote and make your event unforgettable.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to "Book a Venue →", new_booking_path, class: "btn-primary" %>
      <%= link_to "Contact Us", contact_path, class: "btn-secondary" %>
    </div>
  </div>
</div>

<%# Add these styles to your application.css or tailwind.config.js %>
<style>
  .btn-primary {
    @apply inline-block bg-green-700 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-800 transition-colors;
  }
  
  .btn-secondary {
    @apply inline-block bg-white text-gray-700 px-6 py-3 rounded-lg font-medium border border-gray-300 hover:bg-gray-50 transition-colors;
  }
</style>