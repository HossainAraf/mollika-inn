<h1>Contact Us</h1>

<%= form_with model: @inquiry, url: contact_path do |f| %>
  <div><%= f.label :name %><br><%= f.text_field :name, required: true %></div>
  <div><%= f.label :email %><br><%= f.email_field :email, required: true %></div>
  <div><%= f.label :phone %><br><%= f.text_field :phone %></div>
  <div><%= f.label :subject %><br><%= f.text_field :subject %></div>
  <div><%= f.label :message %><br><%= f.text_area :message, required: true %></div>
  <div><%= f.submit "Send" %></div>
<% end %>