<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin — <%= site_setting("site_name", "Mollika Inn") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body { 
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #f0f2f5;
      }
      
      /* Modern Sidebar Links */
      .sidebar-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 1rem;
        border-radius: 0.75rem;
        color: #94a3b8;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        cursor: pointer;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
      }
      
      .sidebar-link::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(16, 185, 129, 0.05));
        opacity: 0;
        transition: opacity 0.25s ease;
        border-radius: 0.75rem;
      }
      
      .sidebar-link:hover {
        color: #fff;
        transform: translateX(4px);
        background: rgba(34, 197, 94, 0.12);
      }
      
      .sidebar-link:hover::before {
        opacity: 1;
      }
      
      .sidebar-link .icon {
        font-size: 1.1rem;
        transition: transform 0.2s ease;
        position: relative;
        z-index: 1;
        flex-shrink: 0;
      }
      
      .sidebar-link:hover .icon {
        transform: scale(1.1);
      }
      
      .sidebar-link .link-text {
        position: relative;
        z-index: 1;
        flex: 1;
      }
      
      .sidebar-link .badge {
        position: relative;
        z-index: 1;
        background: rgba(34, 197, 94, 0.2);
        color: #34d399;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 9999px;
        flex-shrink: 0;
      }
      
      .sidebar-active {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(16, 185, 129, 0.1)) !important;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.15);
        border: 1px solid rgba(34, 197, 94, 0.15);
      }
      
      .sidebar-active::before {
        opacity: 1;
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(16, 185, 129, 0.08));
      }
      
      .sidebar-active::after {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 24px;
        background: linear-gradient(to bottom, #22c55e, #10b981);
        border-radius: 0 4px 4px 0;
        box-shadow: 0 0 12px rgba(34, 197, 94, 0.4);
      }
      
      /* Scrollbar Styling */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      
      ::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
      }
      
      ::-webkit-scrollbar-thumb {
        background: linear-gradient(to bottom, #22c55e, #10b981);
        border-radius: 10px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to bottom, #16a34a, #059669);
      }
      
      /* Glass morphism enhancements */
      .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      
      .glass-dark {
        background: rgba(17, 24, 39, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      
      /* Notification badge pulse animation */
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
      }
      
      .pulse-dot {
        animation: pulse-dot 2s ease-in-out infinite;
      }
      
      /* Header gradient text */
      .gradient-text {
        background: linear-gradient(135deg, #22c55e, #10b981);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Fade animation */
      @keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in {
        animation: fade-in 0.4s ease-out forwards;
      }

      /* Mobile optimization */
      @media (max-width: 768px) {
        #sidebar {
          transform: translateX(-100%);
          transition: transform 0.3s ease-in-out;
        }
        #sidebar.open {
          transform: translateX(0);
        }
      }
    </style>
  </head>
  <body class="bg-gradient-to-br from-gray-50 via-gray-100 to-gray-50 min-h-screen flex">

    <!-- Toggle Button -->
    <button id="sidebar-toggle" class="md:hidden fixed top-4 left-4 z-30 p-3 rounded-2xl glass shadow-xl hover:shadow-2xl text-gray-700 hover:text-gray-900 transition-all duration-300 hover:scale-105 active:scale-95 group border-0" type="button">
      <svg class="w-6 h-6 transition-transform duration-300 group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Sidebar -->
    <aside id="sidebar" class="w-72 min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 flex flex-col shrink-0 shadow-2xl fixed md:relative z-20 border-r border-white/5">
      
      <!-- Sidebar Header -->
      <div class="px-6 py-6 border-b border-white/5 glass-dark flex-shrink-0">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-500/25 flex-shrink-0">
              <span class="text-white font-bold text-lg">M</span>
            </div>
            <div>
              <p class="text-white font-semibold text-sm tracking-tight"><%= site_setting("site_name", "Mollika Inn") %></p>
              <p class="text-emerald-400/70 text-[10px] font-medium uppercase tracking-wider">Admin Panel</p>
            </div>
          </div>
          <button id="sidebar-close" class="md:hidden p-2 rounded-xl hover:bg-white/10 text-gray-400 hover:text-white transition-all duration-200" type="button">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">
        <%= link_to admin_root_path, class: "sidebar-link #{controller_path == 'admin/dashboard' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">📊</span> 
          <span class="link-text">Dashboard</span>
        <% end %>
        
        <%= link_to admin_bookings_path, class: "sidebar-link #{controller_path == 'admin/bookings' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">📅</span> 
          <span class="link-text">Bookings</span>
          <span class="badge">12</span>
        <% end %>
        
        <%= link_to admin_rooms_path, class: "sidebar-link #{controller_path == 'admin/rooms' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">🛏</span> 
          <span class="link-text">Rooms</span>
        <% end %>
        
        <%= link_to admin_room_types_path, class: "sidebar-link #{controller_path == 'admin/room_types' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">🏷</span> 
          <span class="link-text">Room Types</span>
        <% end %>
        
        <%= link_to admin_guests_path, class: "sidebar-link #{controller_path == 'admin/guests' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">👥</span> 
          <span class="link-text">Guests</span>
        <% end %>
        
        <%= link_to admin_facilities_path, class: "sidebar-link #{controller_path == 'admin/facilities' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">✨</span> 
          <span class="link-text">Facilities</span>
        <% end %>
        
        <%= link_to admin_gallery_albums_path, class: "sidebar-link #{controller_path == 'admin/gallery_albums' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">🖼</span> 
          <span class="link-text">Gallery</span>
        <% end %>
        
        <%= link_to admin_reports_path, class: "sidebar-link #{controller_path == 'admin/reports' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">📈</span> 
          <span class="link-text">Reports</span>
        <% end %>
        
        <%= link_to admin_settings_path, class: "sidebar-link #{controller_path == 'admin/settings' ? 'sidebar-active' : ''}", data: { turbo_frame: "_top" } do %>
          <span class="icon">⚙️</span> 
          <span class="link-text">Settings</span>
        <% end %>
      </nav>

      <!-- Sidebar Footer -->
      <div class="px-3 py-4 border-t border-white/5 space-y-0.5 flex-shrink-0">
        <%= link_to root_path, class: "sidebar-link hover:!bg-white/5", data: { turbo_frame: "_top" } do %>
          <span class="icon">🌐</span> 
          <span class="link-text">View Site</span>
        <% end %>
        <%= link_to session_path, data: { turbo_method: :delete, turbo_frame: "_top" }, class: "sidebar-link hover:!bg-red-500/10 hover:!text-red-400" do %>
          <span class="icon">🚪</span> 
          <span class="link-text">Sign Out</span>
        <% end %>
      </div>
    </aside>

    <!-- Overlay for mobile -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-10 md:hidden opacity-0 pointer-events-none transition-opacity duration-300"></div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header -->
      <header class="glass border-b border-white/20 px-6 py-4 flex items-center justify-between shadow-sm flex-shrink-0">
        <div class="flex items-center gap-4">
          <h1 class="text-gray-800 font-bold text-sm uppercase tracking-wider">
            <span class="gradient-text"><%= content_for(:page_title) || "Admin" %></span>
          </h1>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <div class="flex items-center gap-2 text-gray-500 bg-white/50 px-3 py-1.5 rounded-full">
            <span class="text-base">📅</span>
            <span class="font-medium"><%= Date.today.strftime("%d %b %Y") %></span>
          </div>
          <div class="flex items-center gap-2 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200/50">
            <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span>
            <span class="text-emerald-700 text-xs font-semibold">Live</span>
          </div>
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-semibold text-sm shadow-lg shadow-emerald-500/25 cursor-pointer hover:scale-105 transition-transform">
            A
          </div>
        </div>
      </header>

      <!-- Notifications -->
      <div id="flash-messages">
        <% if notice %>
          <div class="mx-6 mt-4 bg-emerald-50/80 backdrop-blur-sm border-l-4 border-emerald-500 text-emerald-800 px-5 py-3.5 rounded-xl shadow-sm flex items-center gap-3">
            <span class="text-xl">✓</span>
            <span class="text-sm font-medium"><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="mx-6 mt-4 bg-red-50/80 backdrop-blur-sm border-l-4 border-red-500 text-red-800 px-5 py-3.5 rounded-xl shadow-sm flex items-center gap-3">
            <span class="text-xl">⚠</span>
            <span class="text-sm font-medium"><%= alert %></span>
          </div>
        <% end %>
      </div>

      <!-- Main Content Area -->
      <main class="flex-1 p-6 overflow-auto">
        <div class="animate-fade-in">
          <%= yield %>
        </div>
      </main>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const toggleBtn = document.getElementById('sidebar-toggle');
        const closeBtn = document.getElementById('sidebar-close');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        function openSidebar() {
          sidebar.classList.add('open');
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.classList.add('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
          sidebar.classList.remove('open');
          overlay.classList.remove('opacity-100', 'pointer-events-auto');
          overlay.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            openSidebar();
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            closeSidebar();
          });
        }

        if (overlay) {
          overlay.addEventListener('click', function(e) {
            e.stopPropagation();
            closeSidebar();
          });
        }

        // Close on escape key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && sidebar && sidebar.classList.contains('open')) {
            closeSidebar();
          }
        });

        // Handle Turbo navigation events
        document.addEventListener('turbo:before-visit', function() {
          // Close sidebar on mobile before navigation
          if (window.innerWidth < 768) {
            closeSidebar();
          }
        });

        // Re-initialize sidebar state after Turbo navigation
        document.addEventListener('turbo:render', function() {
          if (window.innerWidth < 768) {
            closeSidebar();
          }
        });

        // Handle window resize
        let resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function() {
            if (window.innerWidth >= 768) {
              sidebar.classList.remove('open');
              overlay.classList.remove('opacity-100', 'pointer-events-auto');
              overlay.classList.add('opacity-0', 'pointer-events-none');
              document.body.style.overflow = '';
            }
          }, 250);
        });

        // Ensure sidebar starts closed on mobile
        if (window.innerWidth < 768) {
          sidebar.classList.remove('open');
        }
      });

      // Handle flash messages with Turbo
      document.addEventListener('turbo:load', function() {
        // Auto-hide flash messages after 5 seconds
        const flashMessages = document.getElementById('flash-messages');
        if (flashMessages && flashMessages.children.length > 0) {
          setTimeout(function() {
            flashMessages.style.transition = 'opacity 0.5s ease';
            flashMessages.style.opacity = '0';
            setTimeout(function() {
              flashMessages.innerHTML = '';
            }, 500);
          }, 5000);
        }
      });
    </script>
  </body>
</html>