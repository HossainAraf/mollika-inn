<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || site_setting("site_name", "Moli Inn — Naogaon, Bangladesh") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Use the default Tailwind CDN for development, but consider switching to a custom build for production to optimize performance and reduce unused styles. -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "home", "data-turbo-track": "reload" %>
    
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              inn: { DEFAULT: '#1a3a2a', light: '#2d5a3d', dark: '#0f2219' },
              gold: { DEFAULT: '#c9973e', light: '#e0b45a', dark: '#a07830' }
            },
            fontFamily: {
              serif: ['Georgia', 'Cambria', 'serif'],
            }
          }
        }
      }
    </script>
  </head>

  <body class="bg-stone-50 text-gray-800">

    <%# ── Navigation ─────────────────────────────── %>
    <nav class="bg-inn sticky top-0 z-50 shadow-lg" data-controller="mobile-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <%# Logo %>
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2 text-white" do %>
              <div class="w-8 h-8 bg-gold rounded-full flex items-center justify-center text-inn font-bold text-sm">M</div>
              <span class="font-serif text-xl font-semibold tracking-wide"><%= site_setting("site_name", "Moli Inn") %></span>
            <% end %>
          </div>

          <%# Desktop nav links %>
          <div class="hidden md:flex items-center gap-8">
            <%= link_to "Home",       root_path,      class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Rooms",      rooms_path,     class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Gallery",    gallery_path,   class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Conference",     conference_path, class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Facilities", facilities_path,class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Contact",    contact_path,   class: "nav-link uppercase tracking-widest text-xs" %>
          </div>

          <%# Right side: Book Now + hamburger %>
          <div class="flex items-center gap-3">
            <%= link_to "Book Now", rooms_path, class: "btn-primary text-sm py-2 px-5" %>

            <%# Hamburger — mobile only %>
            <button class="md:hidden text-white focus:outline-none p-1 rounded"
                    type="button"
                    aria-label="Toggle menu"
                    data-mobile-nav-toggle>
              <svg data-mobile-nav-hamburger xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <svg data-mobile-nav-close xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

        </div>
      </div>

      <%# Mobile dropdown menu %>
      <div data-mobile-nav-menu
           class="hidden md:hidden bg-inn-dark border-t border-green-800">
        <div class="px-4 py-3 space-y-1">
          <%= link_to "Home",       root_path,       class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Rooms",      rooms_path,      class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Events",     conference_path, class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Gallery",    gallery_path,    class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Facilities", facilities_path, class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Contact",    contact_path,    class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <div class="pt-2 pb-1">
            <%= link_to "Book Now", rooms_path, class: "block w-full text-center btn-primary text-sm py-2.5" %>
          </div>
        </div>
      </div>
    </nav>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const toggleButton = document.querySelector("[data-mobile-nav-toggle]");
        const menu = document.querySelector("[data-mobile-nav-menu]");
        const hamburger = document.querySelector("[data-mobile-nav-hamburger]");
        const closeIcon = document.querySelector("[data-mobile-nav-close]");

        if (!toggleButton || !menu || !hamburger || !closeIcon) return;

        toggleButton.addEventListener("click", function () {
          const shouldOpen = menu.classList.contains("hidden");

          menu.classList.toggle("hidden", !shouldOpen);
          hamburger.classList.toggle("hidden", shouldOpen);
          closeIcon.classList.toggle("hidden", !shouldOpen);
        });
      });
    </script>

    <%# ── Flash Messages ──────────────────────────── %>
    <% if notice %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-6 py-3 text-sm flex items-center justify-between">
        <span>✓ <%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-800 px-6 py-3 text-sm">
        ⚠ <%= alert %>
      </div>
    <% end %>

    <%# ── Main Content ────────────────────────────── %>
    <main>
      <%= yield %>
    </main>

    <%# ── Footer ──────────────────────────────────── %>
    <footer class="bg-inn text-gray-300 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 bg-gold rounded-full flex items-center justify-center text-inn font-bold text-sm">M</div>
              <span class="font-serif text-xl font-semibold text-white"><%= site_setting("site_name", "MOLI INN") %></span>
            </div>
            <p class="text-sm leading-relaxed text-gray-400">A warm, welcoming hotel in the heart of Naogaon, Bangladesh. Comfortable rooms, attentive service, and a home away from home.</p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4 uppercase text-xs tracking-widest">Quick Links</h4>
            <ul class="space-y-2 text-sm">
              <li><%= link_to "Our Rooms",   rooms_path,     class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Events",      conference_path, class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Gallery",     gallery_path,   class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Facilities",  facilities_path,class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Contact Us",  contact_path,   class: "hover:text-gold transition-colors" %></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4 uppercase text-xs tracking-widest">Contact</h4>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-gold mt-0.5">📍</span>
                <span>
                  <%= link_to raw(site_setting("site_address", "Dogachi, Boalia\nNaogaon-6500, Bangladesh")
                  .to_s.gsub("\n", "<br>")),
                  "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(site_setting("site_address", "Dogachi, Boalia\nNaogaon-6500, Bangladesh"))}",
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "text-blue-600 underline" %>
              </span>

              </li>
              <li class="flex items-center gap-2">
                <span class="text-gold">📞</span>
                <span><%= link_to site_setting("site_phone", "+880 1712 345678"), "tel:#{site_setting('site_phone', '+880 1712 345678')}", class: "hover:text-gold transition-colors" %></span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-gold">✉</span>
                <span><%= link_to site_setting("site_email", "info@moliinn.com"), "mailto:#{site_setting('site_email', 'info@moliinn.com')}", class: "hover:text-gold transition-colors" %></span>
              </li>
            </ul>
          </div>
        </div>
        <div class="border-t border-green-800 mt-10 pt-6 text-center text-xs text-gray-500">
          © <%= Date.today.year %> Hotel Moli Inn. All rights reserved.
        </div>
        <div class="mt-4 text-center text-xs text-gray-400">
        <a href="#top" class="absolute right-4 bottom-4 text-gray-400 hover:text-gray-200 transition-colors" aria-label="Back to top">↑</a>
        Admin Dashboard: <%= link_to "Click Here to sign in", new_session_path, class: "text-sm text-gray-600 hover:text-gray-100" %>
        </div>
      </div>
    </footer>
  </body>
</html>
