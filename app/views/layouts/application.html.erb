<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Mollika Inn — Naogaon, Bangladesh" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              inn: { DEFAULT: '#1a3a2a', light: '#2d5a3d', dark: '#0f2219' },
              gold: { DEFAULT: '#c9973e', light: '#e0b45a', dark: '#a07830' }
            },
            fontFamily: {
              serif: ['Georgia', 'Cambria', 'serif'],
            }
          }
        }
      }
    </script>
    <style>
      body { font-family: 'Segoe UI', system-ui, sans-serif; }
      .hero-bg { background: linear-gradient(135deg, #1a3a2a 0%, #2d5a3d 50%, #1a3a2a 100%); }
      .gold-text { color: #c9973e; }
      .btn-primary { background: #c9973e; color: white; padding: 0.75rem 2rem; border-radius: 0.375rem; font-weight: 600; transition: background 0.2s; display: inline-block; }
      .btn-primary:hover { background: #a07830; }
      .btn-outline { border: 2px solid #c9973e; color: #c9973e; padding: 0.65rem 1.75rem; border-radius: 0.375rem; font-weight: 600; transition: all 0.2s; display: inline-block; }
      .btn-outline:hover { background: #c9973e; color: white; }
      .card { background: white; border-radius: 0.75rem; box-shadow: 0 2px 12px rgba(0,0,0,0.08); overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
      .card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
      .nav-link { color: #e8e0d0; font-size: 0.9rem; letter-spacing: 0.05em; transition: color 0.2s; }
      .nav-link:hover { color: #c9973e; }
      .section-title { font-family: Georgia, serif; font-size: 2rem; font-weight: 700; color: #1a3a2a; }
      .star { color: #f59e0b; }
    </style>
  </head>

  <body class="bg-stone-50 text-gray-800">

    <%# ── Navigation ─────────────────────────────── %>
    <nav class="bg-inn sticky top-0 z-50 shadow-lg" data-controller="mobile-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <%# Logo %>
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2 text-white" do %>
              <div class="w-8 h-8 bg-gold rounded-full flex items-center justify-center text-inn font-bold text-sm">M</div>
              <span class="font-serif text-xl font-semibold tracking-wide">Mollika Inn</span>
            <% end %>
          </div>

          <%# Desktop nav links %>
          <div class="hidden md:flex items-center gap-8">
            <%= link_to "Home",       root_path,      class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Rooms",      rooms_path,     class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Gallery",    gallery_path,   class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Facilities", facilities_path,class: "nav-link uppercase tracking-widest text-xs" %>
            <%= link_to "Contact",    contact_path,   class: "nav-link uppercase tracking-widest text-xs" %>
          </div>

          <%# Right side: Book Now + hamburger %>
          <div class="flex items-center gap-3">
            <%= link_to "Book Now", rooms_path, class: "btn-primary text-sm py-2 px-5" %>

            <%# Hamburger — mobile only %>
            <button class="md:hidden text-white focus:outline-none p-1 rounded"
                    data-action="click->mobile-nav#toggle"
                    aria-label="Toggle menu">
              <%# Hamburger icon %>
              <svg data-mobile-nav-target="hamburger" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <%# Close icon (hidden by default) %>
              <svg data-mobile-nav-target="close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

        </div>
      </div>

      <%# Mobile dropdown menu %>
      <div data-mobile-nav-target="menu"
           class="hidden md:hidden bg-inn-dark border-t border-green-800">
        <div class="px-4 py-3 space-y-1">
          <%= link_to "Home",       root_path,       class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Rooms",      rooms_path,      class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Gallery",    gallery_path,    class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Facilities", facilities_path, class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <%= link_to "Contact",    contact_path,    class: "block py-2.5 px-3 rounded text-gray-200 hover:bg-inn-light hover:text-gold text-sm font-medium tracking-wide transition-colors" %>
          <div class="pt-2 pb-1">
            <%= link_to "Book Now", rooms_path, class: "block w-full text-center btn-primary text-sm py-2.5" %>
          </div>
        </div>
      </div>
    </nav>

    <%# ── Flash Messages ──────────────────────────── %>
    <% if notice %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-6 py-3 text-sm flex items-center justify-between">
        <span>✓ <%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-800 px-6 py-3 text-sm">
        ⚠ <%= alert %>
      </div>
    <% end %>

    <%# ── Main Content ────────────────────────────── %>
    <main>
      <%= yield %>
    </main>

    <%# ── Footer ──────────────────────────────────── %>
    <footer class="bg-inn text-gray-300 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div class="w-8 h-8 bg-gold rounded-full flex items-center justify-center text-inn font-bold text-sm">M</div>
              <span class="font-serif text-xl font-semibold text-white">Mollika Inn</span>
            </div>
            <p class="text-sm leading-relaxed text-gray-400">A warm, welcoming hotel in the heart of Naogaon, Bangladesh. Comfortable rooms, attentive service, and a home away from home.</p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4 uppercase text-xs tracking-widest">Quick Links</h4>
            <ul class="space-y-2 text-sm">
              <li><%= link_to "Our Rooms",   rooms_path,     class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Gallery",     gallery_path,   class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Facilities",  facilities_path,class: "hover:text-gold transition-colors" %></li>
              <li><%= link_to "Contact Us",  contact_path,   class: "hover:text-gold transition-colors" %></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4 uppercase text-xs tracking-widest">Contact</h4>
            <ul class="space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-gold mt-0.5">📍</span>
                <span>Dogachi, Boalia<br>Naogaon-6500, Bangladesh</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-gold">📞</span>
                <span>+880 1712 345678</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-gold">✉</span>
                <span>info@mollikainn.com</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="border-t border-green-800 mt-10 pt-6 text-center text-xs text-gray-500">
          © <%= Date.today.year %> Mollika Inn. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
