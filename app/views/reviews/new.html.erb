<h1>Write a Review</h1>

<% if @booking.present? %>
  <p>Booking ID: <%= @booking.id %></p>
<% end %>

<%= form_with model: @review, url: reviews_path do |f| %>
  <%= f.hidden_field :booking_id, value: @booking&.id %>
  <div><%= f.label :rating %><br><%= f.number_field :rating, in: 1..5, required: true %></div>
  <div><%= f.label :title %><br><%= f.text_field :title %></div>
  <div><%= f.label :body %><br><%= f.text_area :body, required: true %></div>
  <div><%= f.label :cleanliness_rating %><br><%= f.number_field :cleanliness_rating, in: 1..5 %></div>
  <div><%= f.label :service_rating %><br><%= f.number_field :service_rating, in: 1..5 %></div>
  <div><%= f.label :value_rating %><br><%= f.number_field :value_rating, in: 1..5 %></div>
  <div><%= f.submit "Submit Review" %></div>
<% end %>