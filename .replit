modules = ["bun-1.1"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
ADMIN_EMAIL = "admin@mollikainn.com"
ADMIN_PASSWORD = "mollika2025"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "source /home/runner/.bash_profile && bundle exec rails server -b 0.0.0.0 -p 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
